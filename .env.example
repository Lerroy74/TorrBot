# ===== Обязательное =====
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=
# Куда на сервере складывать фильмы (диск целиком или папка на нём)
MEDIA_DIR=/mnt/media
# Логин/пароль веб-интерфейса Transmission (придумай любые)
TRANSMISSION_USER=admin
TRANSMISSION_PASS=change-me

# ===== Сеть =====
# Прокси для Telegram API (если api.telegram.org заблокирован). Пусто — напрямую.
TG_PROXY=socks5://192.168.1.30:1080
# Прокси для jac.red. Обычно не нужен — jac.red открывается напрямую.
JACRED_PROXY=
JACRED_URL=https://jac.red

# ===== Обложки (TMDB) =====
# Ключ с https://www.themoviedb.org/settings/api — «API Key» или «API Read Access Token».
# Пусто — бот работает без обложек.
TMDB_API_KEY=
TMDB_LANG=ru-RU
# Прокси для TMDB, если api.themoviedb.org заблокирован. Пусто — напрямую.
TMDB_PROXY=

# ===== Доступ =====
# Кому разрешено сразу, без подтверждения (через запятую). Остальные просят доступ через /start.
ALLOWED_IDS=

# ===== Фильтры под приставку (Raspberry Pi 3) =====
MAX_HEIGHT=1080
MAX_SIZE_GB=20
MAX_SIZE_SERIES_GB=80
MIN_SEEDERS=2
BLOCK_CODECS=hevc,av1,vp9
BLOCK_HDR=true
BLOCK_WORDS=10bit,10-bit,remux,camrip,telesync,tsrip

# ===== Прочее =====
PAGE_SIZE=6
MAX_RESULTS=30
POLL_INTERVAL=60
# UID/GID владельца папки MEDIA_DIR на сервере (команда: id)
PUID=1000
PGID=1000
TZ=Asia/Yekaterinburg

# ===== Уведомления админу =====
# Когда пользователь ставит закачку (📥, с кнопкой ✖). 0 — не сообщать.
NOTIFY_ADMIN_ON_ADD=1
# Когда пользователь удаляет через /delete (право даётся в /users). 0 — не сообщать.
NOTIFY_ADMIN_ON_DELETE=1

# ===== Kodi (обновление медиатеки и автоочистка) =====
# В Kodi: Настройки → Службы → Управление → «Разрешить удалённое управление по HTTP».
# Пусто — бот не трогает Kodi.
KODI_URL=http://192.168.1.33:8080/jsonrpc
KODI_USER=kodi
KODI_PASS=
# Как Kodi видит папку MEDIA_DIR (SMB-шара на этом сервере)
KODI_MEDIA_URL=smb://192.168.1.30/media
# Удалять просмотренное через N дней после просмотра. 0 — не удалять.
CLEANUP_DAYS=14
# За сколько часов предупредить админа (кнопка «Оставить»)
CLEANUP_WARN_HOURS=24
CLEANUP_INTERVAL_HOURS=6
# Раз в N минут смотреть, что досмотрели на ТВ, и спрашивать оценку у того, кто качал. 0 — не спрашивать.
RATE_WATCH_MINUTES=30

# ===== Очередь, сторож, еженедельный отчёт и бэкап =====
# Сколько закачек качается одновременно (остальные ждут в очереди). 0 — без очереди.
QUEUE_SIZE=3
# Сторож: раз в N секунд проверяет диск, Transmission, малинку и туннель (VPN)
HEALTH_INTERVAL=300
DISK_WARN_GB=50
KODI_OFFLINE_MIN=30
# Туннель проверяется запросом к HEALTH_URL через HEALTH_PROXY (по умолчанию — TG_PROXY)
HEALTH_URL=https://www.google.com/generate_204
HEALTH_PROXY=
# Отчёт и бэкап админу: день недели (0 — пн … 6 — вс) и час
WEEKLY_DAY=6
WEEKLY_HOUR=10
# Ежедневный бэкап на диск сервера (~/torrbot/data/backups): час и сколько копий хранить. 0 — выкл.
BACKUP_HOUR=4
BACKUP_KEEP=14

# ===== v7: Kodi =====
# Kodi не ответил на «обнови медиатеку» (малинка выключена) — повторять раз в N минут, пока не получится
KODI_RETRY_MIN=5
# Сообщение на экране ТВ, когда закачка готова. 0 — не показывать
KODI_NOTIFY=1

# ===== v7.1: поиск по описанию через ИИ — цепочка сервисов =====
# По порядку; кончился лимит/деньги/нет связи — следующий. Сервисы без ключа пропускаются.
AI_ORDER=yandex,groq,gemini
# Алиса / YandexGPT (Yandex Cloud AI Studio): API-ключ сервисного аккаунта и ID каталога (b1g…)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель: aliceai-llm/latest (Алиса), yandexgpt/latest (Pro), yandexgpt-lite/latest (дешевле) или полный gpt://…
YANDEX_MODEL=aliceai-llm/latest
# Groq (бесплатно): ключ gsk_… с console.groq.com; запросы через прокси (по умолчанию TMDB_PROXY, потом TG_PROXY)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PROXY=
# Gemini (бесплатно, Google): ключ с aistudio.google.com; через прокси (по умолчанию TMDB_PROXY, потом TG_PROXY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PROXY=

# ===== v8: контроль ИИ (стартовые значения — дальше меняются кнопками в /ai) =====
# ИИ-запросов в день на человека и на всех (0 — без лимита)
AI_USER_DAY=10
AI_TOTAL_DAY=50
# Месячный потолок расходов на ИИ, ₽ (0 — выкл). Считается только по сервисам с ценой ниже.
AI_MONTH_RUB=0
# Цена, ₽ за 1000 токенов (вход + выход) — из прайса сервиса. Пусто — сумму не считаем.
AI_PRICE_YANDEX=
AI_PRICE_GROQ=0
AI_PRICE_GEMINI=0

# ===== v7: подписки на сериалы и «ждать хорошую раздачу» =====
SUBS_CHECK_HOURS=6
# Серия вышла N дней назад, а раздача не обновилась — предложить подписчикам другие раздачи
SUBS_FALLBACK_DAYS=7
WAIT_CHECK_HOURS=12
WAIT_MIN_HEIGHT=1080
WAIT_DAYS=180

# ===== v7: детский режим (включается в /users для конкретного человека) =====
KIDS_MAX_AGE=12

# ===== v7: место на диске и зависшие закачки =====
# Сколько ГБ всегда оставлять свободными: закачка, которая не влезает с этим запасом, не ставится
DISK_RESERVE_GB=5
# Закачка без движения N часов — предложить другие раздачи. 0 — не следить
STALL_HOURS=3

# ===== v7: «черепаха» и сторож нагрузки (переключатели — /speed) =====
# Скорость в режиме «черепахи», МБ/с
TURTLE_DOWN_MB=5
TURTLE_UP_MB=1
# Дневной режим: в эти часы притормаживать (если включён в /speed)
DAY_HOURS=08:00-23:00
# Диск занят на LOAD_UTIL% и больше дольше LOAD_ALERT_SEC — перегрузка: тревога и «черепаха»
LOAD_UTIL=90
LOAD_ALERT_SEC=120
# Притормозили из-за перегрузки — держать «черепаху» минимум N минут
LOAD_THROTTLE_MIN=15
# Повтор тревог о перегрузке — не чаще раза в N минут
LOAD_COOLDOWN_MIN=30
# Тариф интернета, Мбит/с: канал считается забитым от 90%
NET_LIMIT_MBIT=300

# Внутренние пути — менять не нужно
TRANSMISSION_URL=http://host.docker.internal:9091/transmission/rpc
DIR_MOVIES=/downloads/movies
DIR_SERIES=/downloads/series
MEDIA_ROOT=/downloads
DB_PATH=/data/bot.sqlite3
# Сюда пишет агент нагрузки (host/load-agent.py) — это ~/torrbot/data/host-load.json
LOAD_FILE=/data/host-load.json
