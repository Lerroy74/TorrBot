# ===== Обязательное =====
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=
# Куда на сервере складывать фильмы (диск целиком или папка на нём)
MEDIA_DIR=/mnt/media
# Логин/пароль веб-интерфейса Transmission (придумай любые)
TRANSMISSION_USER=admin
TRANSMISSION_PASS=change-me

# ===== Сеть =====
# Прокси для Telegram API (если api.telegram.org заблокирован). Пусто — напрямую.
TG_PROXY=socks5://192.168.1.30:1080
# Прокси для jac.red. Обычно не нужен — jac.red открывается напрямую.
JACRED_PROXY=
JACRED_URL=https://jac.red

# ===== Обложки (TMDB) =====
# Ключ с https://www.themoviedb.org/settings/api — «API Key» или «API Read Access Token».
# Пусто — бот работает без обложек.
TMDB_API_KEY=
TMDB_LANG=ru-RU
# Прокси для TMDB, если api.themoviedb.org заблокирован. Пусто — напрямую.
TMDB_PROXY=

# ===== Доступ =====
# Кому разрешено сразу, без подтверждения (через запятую). Остальные просят доступ через /start.
ALLOWED_IDS=

# ===== Фильтры под приставку (Raspberry Pi 3) =====
MAX_HEIGHT=1080
MAX_SIZE_GB=20
MAX_SIZE_SERIES_GB=80
MIN_SEEDERS=2
BLOCK_CODECS=hevc,av1,vp9
BLOCK_HDR=true
BLOCK_WORDS=10bit,10-bit,remux,camrip,telesync,tsrip

# ===== Прочее =====
PAGE_SIZE=6
MAX_RESULTS=30
POLL_INTERVAL=60
# UID/GID владельца папки MEDIA_DIR на сервере (команда: id)
PUID=1000
PGID=1000
TZ=Asia/Yekaterinburg

# ===== Уведомления админу =====
# Когда пользователь ставит закачку (📥, с кнопкой ✖). 0 — не сообщать.
NOTIFY_ADMIN_ON_ADD=1
# Когда пользователь удаляет через /delete (право даётся в /users). 0 — не сообщать.
NOTIFY_ADMIN_ON_DELETE=1

# ===== Kodi (обновление медиатеки и автоочистка) =====
# В Kodi: Настройки → Службы → Управление → «Разрешить удалённое управление по HTTP».
# Пусто — бот не трогает Kodi.
KODI_URL=http://192.168.1.33:8080/jsonrpc
KODI_USER=kodi
KODI_PASS=
# Как Kodi видит папку MEDIA_DIR (SMB-шара на этом сервере)
KODI_MEDIA_URL=smb://192.168.1.30/media
# Удалять просмотренное через N дней после просмотра. 0 — не удалять.
CLEANUP_DAYS=14
# За сколько часов предупредить админа (кнопка «Оставить»)
CLEANUP_WARN_HOURS=24
CLEANUP_INTERVAL_HOURS=6

# ===== Очередь, сторож, еженедельный отчёт и бэкап =====
# Сколько закачек качается одновременно (остальные ждут в очереди). 0 — без очереди.
QUEUE_SIZE=3
# Сторож: раз в N секунд проверяет диск, Transmission, малинку и туннель (VPN)
HEALTH_INTERVAL=300
DISK_WARN_GB=50
KODI_OFFLINE_MIN=30
# Туннель проверяется запросом к HEALTH_URL через HEALTH_PROXY (по умолчанию — TG_PROXY)
HEALTH_URL=https://www.google.com/generate_204
HEALTH_PROXY=
# Отчёт и бэкап админу: день недели (0 — пн … 6 — вс) и час
WEEKLY_DAY=6
WEEKLY_HOUR=10

# Внутренние пути — менять не нужно
TRANSMISSION_URL=http://host.docker.internal:9091/transmission/rpc
DIR_MOVIES=/downloads/movies
DIR_SERIES=/downloads/series
MEDIA_ROOT=/downloads
DB_PATH=/data/bot.sqlite3
