# Секреты для скриптов малинки. Скопируй в secrets.env и заполни.
# secrets.env в git НЕ попадает (.gitignore) — пароли остаются только у тебя.

# --- логины трекеров для Elementum Burst (kodi-setup.sh) ---
TR_PASS=''            # общий пароль трекеров
NNM_USER=''
RUSTORKA_USER=''
LOSTFILM_USER=''      # у lostfilm логин — почта
RUTRACKER_USER=''

# --- веб-управление Kodi (то же, что KODI_PASS в .env бота) ---
KODI_WEB_PASS=''

# --- сторож малинки (pi-watch.sh): куда писать в Telegram (необязательно) ---
# Пусто — сторож молча чинит и пишет только в журнал.
BOT_TOKEN=''
ADMIN_IDS=''          # через запятую
TG_PROXY='socks5h://192.168.1.30:1080'   # Telegram с малинки — через прокси сервера
